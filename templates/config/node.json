{
  "checks": {
    "typescript": "npx tsc --noEmit",
    "lint": "npm run lint",
    "test": "npm test"
  },
  "api": {
    "baseUrl": "http://localhost:3000"
  },
  "playwright": {
    "enabled": true,
    "testDir": "tests/e2e",
    "projects": ["chromium", "mobile"]
  },
  "verification": {
    "codeReviewEnabled": true,
    "mcpEnabled": true,
    "a11yEnabled": true,
    "mobileViewport": 375
  },
  "maxIterations": 20,
  "maxSessionSeconds": 600,
  "testUrlBase": "http://localhost:3000",
  "contextRotThreshold": {
    "maxStories": 10,
    "maxFilesChanged": 20
  }
}
